{
  "_version": "1.89.0",
  "sap.app": {
    "id": "project1",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "937b1a6a-f054-4ca0-8c25-29d09af0c15d"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/asset-management/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.viz": {}
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController#project1::AssetsList": {
            "controllerName": "project1.ext.controller.ListReportController"
          }
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "project1.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": "admin-dashboard",
          "name": "AdminDashboard",
          "target": "AdminDashboard"
        },
        {
          "pattern": "manager-dashboard",
          "name": "ManagerDashboard",
          "target": "ManagerDashboard"
        },
        {
          "pattern": "employee-dashboard",
          "name": "EmployeeDashboard",
          "target": "EmployeeDashboard"
        },
        {
          "pattern": "reports:?query:",
          "name": "Reports",
          "target": "Reports"
        },
        {
  "pattern": "",
  "name": "Landing",
  "target": "Landing"
},
{
  "pattern": "Assets:?query:",
  "name": "AssetsList",
  "target": "AssetsList"
},
        {
          "pattern": "Assets({key}):?query:",
          "name": "AssetsObjectPage",
          "target": "AssetsObjectPage"
        }
      ],
      "targets": {
        "Landing": {
  "type": "View",
  "id": "Landing",
  "name": "project1.ext.landing.Landing"
},
        "AdminDashboard": {
          "type": "View",
          "id": "AdminDashboard",
          "name": "project1.ext.dashboard.AdminDashboard"
        },
        "ManagerDashboard": {
          "type": "View",
          "id": "ManagerDashboard",
          "name": "project1.ext.dashboard.ManagerDashboard"
        },
        "EmployeeDashboard": {
          "type": "View",
          "id": "EmployeeDashboard",
          "name": "project1.ext.dashboard.EmployeeDashboard"
        },
        "Reports": {
          "type": "View",
          "id": "Reports",
          "name": "project1.ext.reports.Reports"
        },
        "AssetsList": {
          "type": "Component",
          "id": "AssetsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Assets",
              "variantManagement": "Page",
              "navigation": {
                "Assets": {
                  "detail": {
                    "route": "AssetsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "CreateAsset": {
  "text": "Add Asset",
  "press": "project1.ext.controller.ListReport.onCreateAsset",
  "requiresSelection": false,
  "visible": "{user>/isAdmin}"
},
                    "BackToSourceDashboard": {
                      "text": "Back",
                      "press": "project1.ext.controller.ListReport.onBackToSourceDashboard",
                      "requiresSelection": false,
                      "visible": "{user&gt;/loaded}"
                    },
                    "OpenAdminDashboard": {
                      "text": "Admin",
                      "press": "project1.ext.controller.ListReport.onOpenAdminDashboard",
                      "requiresSelection": false
                    },
                    "OpenManagerDashboard": {
                      "text": "Manager",
                      "press": "project1.ext.controller.ListReport.onOpenManagerDashboard",
                      "requiresSelection": false
                    },
                    "OpenEmployeeDashboard": {
                      "text": "Employee",
                      "press": "project1.ext.controller.ListReport.onOpenEmployeeDashboard",
                      "requiresSelection": false
                    },
                    "OpenReports": {
                      "text": "Reports",
                      "press": "project1.ext.controller.ListReport.onOpenReports",
                      "requiresSelection": false,
                      "visible": "{user&gt;/loaded}"
                    }
                  }
                }
              }
            }
          }
        },
        "AssetsObjectPage": {
          "type": "Component",
          "id": "AssetsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Assets",
              "content": {
  "header": {
    "actions": {
      "BackToAssets": {
        "text": "Back",
        "press": "project1.ext.controller.ObjectPage.onBackToAssets"
      }
    }
  }
}
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}